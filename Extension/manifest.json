{
  "manifest_version": 3,
  "name": "FreeProxy VPN Extension",
  "version": "1.1.0",
  "description": "Routes this browser through the FreeProxy VPN Tor engine and reports the connected country's location instead of your real one.",
  "minimum_chrome_version": "111",
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["geo-spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["geo-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ]
}
